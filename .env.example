# Backend-3 (EC2 10.0.1.13): pagos + recomendaciones + broker Kafka.
# Copiar a .env y completar. Nunca commitear secretos.

# Origen CORS del frontend (IP pública / dominio del EC2 frontend).
FRONTEND_ORIGIN=http://localhost:5173

# Kafka: dentro del compose se usa el nombre del servicio.
# Los backends 1 y 2 (otras instancias) usan 10.0.1.13:29092.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# JWT local (mismo secreto en TODOS los servicios).
JWT_LOCAL_ENABLED=false
JWT_LOCAL_SECRET=cambiar-en-produccion-secreto-compartido-32bytes
JWT_LOCAL_ISSUER=pedidos360-usuarios
JWT_LOCAL_AUDIENCE=pedidos360-api
JWT_LOCAL_REQUIRED_SCOPE=orders.write

# Azure Entra ID (opcional).
JWT_ENABLED=false
JWT_JWKS_URI=
JWT_ISSUER_URI=
JWT_AUDIENCES=

# Recomendaciones -> servicio-productos.
PRODUCTOS_URL=http://10.0.1.11:8081

# WebPay Plus (Transbank). WEBPAY_ENABLED=false usa el simulador.
WEBPAY_ENABLED=false
WEBPAY_ENV=INTEGRATION
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL=http://localhost:8087/payments/webpay/return
WEBPAY_FRONTEND_URL=http://localhost:5173

# Detección de fraude (score 0-100).
FRAUDE_UMBRAL_APROBADO=40
FRAUDE_UMBRAL_REVISION=70

# Heaps chicos: host t3.small compartido por Kafka + 2 JVM.
JAVA_OPTS_PAGOS=-Xms96m -Xmx256m
JAVA_OPTS_RECOMENDACIONES=-Xms96m -Xmx256m
